---
import Page from "../template/Page.astro";
import Sidebar from "../components/Sidebar.astro";
import Navbar from "../components/Navbar.astro";
---

<Page title="Outbound">
    <Sidebar active="outbound" />
    <Navbar />
    <main id="dashboard">
        <div class="container">
            <div class="between">
                <div class="title-container">
                    <h2 class="title">Outbound Request</h2>
                    <p class="subtitle">
                        Request for enrollment and recommendation letters
                    </p>
                </div>
                <a href="#" class="btn green">Create</a>
            </div>

            <div class="card-list">
                <div class="card">
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>NAME</th>
                                    <th>PROGRAM</th>
                                    <th>LETTER TYPE</th>
                                    <th>STATUS</th>
                                    <th>ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>#6000</td>
                                    <td>Aung Ko Latt</td>
                                    <td>ASEAN Student Exchange</td>
                                    <td>Enrollment</td>
                                    <td>
                                        <div class="badge rejected">
                                            Rejected
                                        </div>
                                    </td>
                                    <td>
                                        <button type="button" class="gray">Details</button>
                                    </td>
                                </tr>

                                <tr>
                                    <td>#9283</td>
                                    <td>Lim Wie Jie</td>
                                    <td>
                                        Summer Course Sustainable Development
                                    </td>
                                    <td>Director Recommendation</td>
                                    <td>
                                        <div class="badge pending">Pending</div>
                                    </td>
                                    <td> <button type="button" class="gray">Details</button> </td>
                                </tr>

                                <tr>
                                    <td>#8927</td>
                                    <td>Somchal Prasert</td>
                                    <td>
                                        Summer Course Sustainable Development
                                    </td>
                                    <td>Director Recommendation</td>
                                    <td>
                                        <div class="badge approved">
                                            Approved
                                        </div>
                                    </td>
                                    <td> <button type="button" class="gray">Details</button>  </td>
                                </tr>

                                <tr>
                                    <td>#0182</td>
                                    <td>Maria Santosa</td>
                                    <td>ASEAN Student Exchange</td>
                                    <td>Visa Recommendation</td>
                                    <td>
                                        <div class="badge approved">
                                            Approved
                                        </div>
                                    </td>
                                    <td> <button type="button" class="gray">Details</button>  </td>
                                </tr>

                                <tr>
                                    <td>#7103</td>
                                    <td>Nguyen Van An</td>
                                    <td>ASEAN Student Exchange</td>
                                    <td>Enrollment</td>
                                    <td>
                                        <div class="badge approved">
                                            Approved
                                        </div>
                                    </td>
                                    <td> <button type="button" class="gray">Details</button>  </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Page>
