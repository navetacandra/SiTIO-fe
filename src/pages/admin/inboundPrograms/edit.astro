---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
import Input from "../../../components/Input.astro";
---

<Page title="Edit Inbound Programs">
    <Sidebar active="/admin/inboundPrograms/edit" />
    <Navbar />
    <main id="/admin/dashboard">
        <div class="container">
            <div class="card">
                <div class="title-container">   
                    <h3 class="title">
                        Edit Inbound Program
                    </h3>
                </div>

                <Input
                    label="Name"
                    id="name"
                    placeholder="Name of the program"
                    type="text"
                    required
                    showRequidred
                />
                <Input
                    label="Study Program"
                    id="study_program"
                    placeholder="Select a study program"
                    type="textarea"
                    required
                    showRequired   
                />
            </div>

            <div class="input-box3">
                <button type="button" class="btn-submit" onclick="window.location.href='/admin/inboundPrograms'" >Update Inbound Program </button>
                <a href="/admin/inboundPrograms" class="back">Cancel</a>
            </div>
        </div>
    </main>
</Page>