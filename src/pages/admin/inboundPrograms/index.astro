---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
---

<Page title = "Inbound Programs">
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css"
    />
    <script defer src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script defer is:inline>
        function showDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Delete',
                confirmButtonColor: 'var(--red)',
                html: `
                    <form method="POST" action="#" id="delete-form" style="display: none;">
                        <input type="hidden" name="id" value="${id}">
                    </form>
                `,
                preConfirm: () => {
                    sessionStorage.setItem('deleteSuccess', 'true');
                    document.querySelector('#delete-form').submit();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (sessionStorage.getItem('deleteSuccess') === 'true') {
                sessionStorage.removeItem('deleteSuccess');

                Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.onmouseenter = Swal.stopTimer;
                        toast.onmouseleave = Swal.resumeTimer;
                    }
                }).fire({
                    icon: 'success',
                    title: 'Deleted successfully'
                });
            }
        });
    </script>
    <Sidebar active="inboundPrograms" />
    <Navbar />
    <main id="/admin/dashboard">
        <div class="container">
            <div class="between pdln-header">
                <div class="title-container">
                    <h2 class="title">Inbound Programs</h2>
                    <p class="subtitle">Request for enrollment and recommendation letter.</p>
                </div>
                <button type="button" class="btn-create" onclick="location.href='/admin/inboundPrograms/create'">Create Inbound Program</button>
            </div>

                <div class="table-container" style="width: 100%">
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Studi Program</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Summer Course Sustainable Development</td>
                                <td>Hubungan International</td>
                                <td>15 Jun 2026</td>
                                <td>15 Jul 2026</td>
                                <td> 
                                    <button type="button" class="btn-edit" onclick="window.location.href='/admin/inboundPrograms/edit'">Edit</button>
                                    <button type="button" class="btn-delete" onclick="showDelete(1)">Delete</button>
                                </td>
                            </tr>

                            <tr>
                                <td>Summer Course Sustainable Development</td>
                                <td>Teknik Informatika</td>
                                <td>1 Sept 2025</td>
                                <td>31 Jan 2026</td>
                                <td> 
                                    <button type="button" class="btn-edit" onclick="window.location.href='/admin/inboundPrograms/edit'">Edit</button>
                                    <button type="button" class="btn-delete" onclick="showDelete(2)">Delete</button>
                                </td>   
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
    </main>
</Page>