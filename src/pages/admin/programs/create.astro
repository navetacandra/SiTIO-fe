---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
import Input from "../../../components/Input.astro";
---

<Page title="Create Programs">
    <Sidebar active="programs/create" />
    <Navbar />
    <main id="/admin/dashboard">
        <div class="container">
            <div class="card">
                <div class="title-container">
                    <h3 class="title">Create Program</h3>
                </div>
                
                <Input
                    label="Name"
                    id="name"
                    placeholder="Name of the program"
                    type="text"
                    required
                    showRequired
                />
                <Input
                    label="Study Program"
                    id="study_program"
                    placeholder="Study program of the program"
                    type="text"
                    required
                    showRequired
                />
            </div>

            <div class="input-box3">
                <button type="button" class="btn-submit" onclick="document.location='/admin/programs'">Create Programs</button>
                <a href="/admin/programs" class="back">Cancel</a>
            </div>
        </div>
    </main>
</Page>