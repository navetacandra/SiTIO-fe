---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
import Input from "../../../components/Input.astro";
---


<Page title="Outbound Details">
    <Sidebar active="outbound/details" />
    <Navbar />
    <main>
        <div class="container">
            
            <div class="card3">
                <div class="title-container">
                    <h3 class="title details-title">
                        <span>#600000 · Summer Course Sustainable Development# </span>
                    </h3>

                </div>
                <div class="card-detail">
                <div style="padding-bottom: 1.5%">
                <div class="input-cols">
               <p class="content-title">CREATOR</p>
               <p class="content-title" style="margin-left: 13%;">START DATE</p>
               <p class="content-title" >GO AS</p>
                </div>
                <div class="input-cols">
               <p class="content-body" style="font-weight: 500;">Risky Pratama <span class="content-body-thin">MAHASISWA</span> </p>
               <p class="content-body" style="font-weight: 500; margin-left: 13%;">02 Mar 2026</p>
               <p class="content-body" style="font-weight: 500; ">Mahasiswa</p>
                </div>
                </div>
                
                <div style="padding-bottom: 1.5%">
                <div class="input-cols">
               <p class="content-title">ACADEMIC YEAR / SEMESTER</p>
               <p class="content-title" style="margin-left: 13%;">END DATE</p>
               <p class="content-title" style="">LETTER TYPE</p>
                </div>
                <div class="input-cols">
               <p class="content-body" style="font-weight: 500;">2025 / 2</p>
               <p class="content-body" style="font-weight: 500; margin-left: 13%;">14 Mar 2026</p>
               <p class="content-body" style="font-weight: 500; ">Enrollment</p>
                </div>
                </div>

                <div style="padding-bottom: 1.5%">
                <div class="input-cols">
               <p class="content-title">PROGRAM</p>
               <p class="content-title" style="margin-left: 13%;">DECIDED AT</p>
               <p class="content-title"></p>
                </div>
                <div class="input-cols">
               <p class="content-body" style="font-weight: 500;">Research Collaboration</p>
               <p class="content-body" style="font-weight: 500; margin-left: 13%;">-</p>
               <p class="content-body" style="font-weight: 500;"> </p>
                </div>
                </div>

                <div style="padding-bottom: 1.5%">
                <div class="input-cols">
                     <p class="content-title">DESTINATION</p>
               <p class="content-title" style="margin-left: 13%;">DECIDER</p>
               <p class="content-title" >LETTER</p>
                </div>
                <div class="input-cols">
                    <p class="content-body" style="font-weight: 500;">Delft University of Technology, Belanda</p>
               <p class="content-body" style="font-weight: 500; margin-left: 13%;">-</p>
               <p class="content-body" style="font-weight: 400; opacity: 0.4; ">Not Uploaded</p>
                </div>
                </div>
                
            </div>
            <div class="input-cols2" style="margin-top: 30px;">
                <div class="card"> 
                        <div class="title-container">
                    <h3 class="title">Update Status</h3>
                </div>
                        <p class="label">New Status</p>
                    <div class="status-row">
                        <div class="dropdown">
                <button class="dropbtn">Approved (current) 
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                    </svg>
                </button>
                <div class="dropdown-content">
                <a href="#">Rejected</a>
                <a href="#">Pending</a>
                <a href="#">Approved</a>
                </div>
                </div>
                 <input type="submit" class="btn-submit2" value="Apply">
             
             </div>

                    </div>
                <div class="card"> 
                          <div class="title-container">
                    <h3 class="title">Upload Letter</h3>
                </div>
                        <p class="label">Choose File</p>
                    <div class="status-row">
                        <div class="dropdown">
                            <div class="dropbtn">
                                <span>Upload</span>
                                <input
                                    id="Undangan"
                                    type="file"
                                    required
                                />
                    </div>
                </div>
                 <input type="submit" class="btn-submit2" value="Apply">
             
             </div>
                </div>

                </div>
            </div>
            </div>

            
            <a href="/admin/outbound" class="back" style="padding-left: 3%;">Back to outbound</a>

    </main>
</Page>
