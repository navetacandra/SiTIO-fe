---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
---

<Page title="/admin/faq">
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script is:inline>
        function showDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Delete',
                confirmButtonColor: 'var(--red)',
                html: `
                    <form method="POST" action="#" id="delete-form" style="display: none;">
                        <input type="hidden" name="id" value="${id}">
                    </form>
                `,
                preConfirm: () => {
                    sessionStorage.setItem('deleteSuccess', 'true');
                    document.querySelector('#delete-form').submit();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (sessionStorage.getItem('deleteSuccess') === 'true') {
                sessionStorage.removeItem('deleteSuccess');

                Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.onmouseenter = Swal.stopTimer;
                        toast.onmouseleave = Swal.resumeTimer;
                    }
                }).fire({
                    icon: 'success',
                    title: 'Deleted successfully'
                });
            }
        });
    </script>
    <Sidebar active="faq" />
    <Navbar />
    <main id="/admin/dashboard">
        <div class="container">
            <div class="between pdln-header">
                <div class="title-container">
                    <h2 class="title">FAQ</h2>
                    <p class="subtitle">Question and answer are shown to users</p>
                </div>
                    <button type="button" class="btn-create" onclick="window.location.href='/admin/faq/create'">Create FAQ</button>
            </div>
               
            <div class="table-container">
              <table>
                <thead>
                    <tr>
                        <th>QUESTION</th>
                        <th>ANSWER</th>
                        <th>UPDATED BY</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Apakah pengajuan yang ditolak dapat diajukan ulang?</td>
                        <td>Pengajuan dengan status REVISION dapat diperbaiki dan diajukan ulang, sedangkan pengajuan REJECTED harus dibuat baru.</td>
                        <td>Siti Aminah</td>
                        <td>
                            <button type="button" class="gray" onclick="window.location.href='/admin/faq/edit'">Edit</button>
                            <button type="button" class="gray" onclick="showDelete(1)">Delete</button>
                        </td>
                    </tr>

                    <tr>
                        <td>Bagaimana cara mengetahui status pengajuan?</td>
                        <td>Status pengajuan dapat dilihat pada halaman detail PDLN atau Outbound. Status akan berubah sesuai tahapan verifikasi.</td>
                        <td>Siti Aminah</td>
                        <td>
                            <button type="button" class="gray" onclick="window.location.href='/admin/faq/edit'">Edit</button>
                            <button type="button" class="gray" onclick="showDelete(2)">Delete</button>
                        </td>
                    </tr>

                    <tr>
                        <td>Apa dokumen yang diperlukan dalam persyaratan outbound?</td>
                        <td>Dokumen wajib meliputi surat permohonan, surat persetujuan dosen pembimbing, dan laporan akhir setelah kegiatan selesai.</td>
                        <td>Dr. Ahmad Fauzi, M.T.</td>
                        <td>
                            <button type="button" class="gray" onclick="window.location.href='/admin/faq/edit'">Edit</button>
                            <button type="button" class="gray" onclick="showDelete(3)">Delete</button>
                        </td>
                    </tr>


                    <tr>
                        <td>Apa itu SiTIO?</td>
                        <td>SiTIO adalah sistem informasi terintegrasi untuk pengelolaan kegiatan internasional mahasiswa dan dosen.</td>
                        <td>Dr. Ahmad Fauzi, M.T.</td>
                        <td>
                            <button type="button" class="gray" onclick="window.location.href='/admin/faq/edit'">Edit</button>
                            <button type="button" class="gray" onclick="showDelete(4)">Delete</button>
                        </td>
                    </tr>
                </tbody>
              </table>
            </div>
        </div>
    </main>
</Page>