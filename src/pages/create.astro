---
import Page from "../template/Page.astro";
import Sidebar from "../components/Sidebar.astro";
import Input from "../components/Input.astro";
---

<Page title="Home">
    <Sidebar active="dashboard" />
    <main>
        <div class="container">
            <div class="title-container">
                <h2 class="title">Create PDLN</h2>
                <p class="subtitle">
                    A new PDLN starts in Pending status and includes you as a
                    participant.
                </p>
            </div>
            <div class="card">
                <div class="title-container">
                    <h3 class="title">Activity</h3>
                </div>
                <Input
                    label="Activity Name"
                    id="activity_name"
                    placeholder="Name of activity"
                    type="text"
                    error="Contoh text error"
                    required
                    showRequired
                />
                <div class="input-cols">
                    <Input
                        label="Activity Type"
                        id="activity_type"
                        placeholder="Type of activity (e.g International Confrence)"
                        type="text"
                        required
                        showRequired
                    />
                    <Input
                        label="Destination Country"
                        id="destination_country"
                        placeholder="Country where activities take place"
                        type="text"
                        required
                        showRequired
                    />
                </div>
                <div class="input-cols">
                    <Input
                        label="Destination City"
                        id="destination_city"
                        placeholder="City where activities take place"
                        type="text"
                        required
                        showRequired
                    />
                    <Input
                        label="Destination Institution"
                        id="destination_institution"
                        placeholder="Institution where activities take place or which invites"
                        type="text"
                        required
                        showRequired
                    />
                </div>
                <div class="input-cols">
                    <Input
                        label="Start Date"
                        id="start_date"
                        type="date"
                        required
                        showRequired
                    />
                    <Input
                        label="End Date"
                        id="end_date"
                        type="date"
                        required
                        showRequired
                    />
                </div>
                <Input
                    label="Follow Up Plan"
                    id="followup_plan"
                    type="textarea"
                    placeholder="Follow up plan after this activity"
                    required
                    showRequired
                />
            </div>
            <div class="card">
                <div class="title-container">
                    <h3 class="title">Documents</h3>
                </div>
                <div class="input-flex">
                    <Input
                        label="Brosur"
                        id="brosur"
                        type="file"
                        hint="PDF, JPG, or PNG (max. 5MB)"
                        required
                        showRequired
                    />
                    <Input
                        label="Brosur"
                        id="brosur"
                        type="file"
                        hint="PDF, JPG, or PNG (max. 5MB)"
                        required
                        showRequired
                    />
