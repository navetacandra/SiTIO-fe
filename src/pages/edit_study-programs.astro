---
import Page from "../template/Page.astro";
import Sidebar from "../components/Sidebar.astro";
import Navbar from "../components/Navbar.astro";
import Input from "../components/Input.astro";
---

<Page title="Edit Study Programs">
    <Sidebar active="edit_study-programs" />
    <Navbar />
    <main id="dashboard">
        <div class="container">
            <div class="card">
                <div class="title-container">
                    <h3 class="title">Edit Study Program</h3>
                </div>
                
                <Input
                    label="Name"
                    id="name"
                    placeholder="Name of the study program"
                    type="text"
                    required
                    showRequired
                />
                <Input
                    label="Department"
                    id="department"
                    placeholder="Department of the study program"
                    type="text"
                    required
                    showRequired    
                />
            </div>

            <div class="input-box3">
                <button type="button" class="btn-submit" onclick="document.location='study-programs'">Update Study Program</button>
                <a href="study-programs" class="back"> Cancel </a>
            </div>
        </div>
    </main>
</Page>