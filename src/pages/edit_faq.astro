---
import Page from "../template/Page.astro";
import Sidebar from "../components/Sidebar.astro";
import Navbar from "../components/Navbar.astro";
import Input from "../components/Input.astro";
---

<Page title="Edit FAQ">
    <Sidebar active="FAQ" />
    <Navbar />
    <main id="dashboard">
        <div class="container">
            <div class="card">
                <div class="title-container">
                    <h3 class="title">Edit FAQ</h3>
                </div>
                
                <Input
                    label="Name"
                    id="name"
                    placeholder="Enter the name"
                    type="text"
                    required
                    showRequired
                />
                <Input
                    label="Question"
                    id="question"
                    placeholder="Enter the question"
                    type="textarea"
                    required
                    showRequired
                />
                <Input
                    label="Answer"
                    id="answer"
                    placeholder="Enter the answer"
                    type="textarea"
                    required
                    showRequired
                />
            </div>

            <div class="input-box3">
                <button type="button" class="btn-submit" onclick="document.location='FAQ'">Update FAQ</button>
                <a href="FAQ" class="back">Cancel</a>
            </div>
        </div>
    </main>
</Page>