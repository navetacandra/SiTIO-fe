---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
---

<Page title="/user/tickets">
    <Sidebar active="tickets" isUser="1"/>
    <Navbar />
    <main id="/user/dashboard">
        <div class="container">
            <div class="empty-state">
                <img src="/user.png" alt="No Tickets Found" width="250" />
                <h2>No Tickets Found</h2>
                <p>
                    It looks like there are no tickets available right now.<br />
                    Click below to create a new ticket
                </p>
                <a href="/user/tickets/create" class="btn-outline-green">Create Tickets</a>
            </div>
        </div>
    </main>
</Page>