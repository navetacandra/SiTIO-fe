
---
import Page from "../../../template/Page.astro";
---

<Page title="404 NotFound">

    <main class="error-page">
        <div class="error-container">

            <div class="error-image">
                <img
                   src="/notfound.svg"
                   alt="404 Unauthorized"
                />
            </div>

            <div class="error-content">
                <h1>404</h1>
                <p class="error-message">NotFound</p>

                <a href="/user/dashboard" class="btn-back">
                    GO BACK
                </a>
            </div>

        </div>
    </main>

</Page>

<style>
    * {
        box-sizing: border-box;
    }

    .error-page {
        min-height: 100vh;
        width: 100%;
        background-color: #f3f4f7;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px;
    }

    .error-container {
        width: 100%;
        max-width: 1100px;
        min-height: 580px;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 60px;
        padding: 50px 70px;
    }

    .error-image {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

  .error-image img {
    width: 800px !important;
    max-width: none !important;
    height: auto;
    object-fit: contain;
}
.error-content {
    flex: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    position: relative;
    left: -250px;
}
    .error-content h1 {
        font-size: 150px;
        font-weight: 700;
        color: #000000;
        line-height: 1;
        margin: 0;
    }

    .error-message {
        font-size: 36px;
        color: #000000;
        margin: 20px 0 32px;
        font-weight: 400;
    }

    .btn-back {
        background-color: #005b46;
        color: #ffffff;
        text-decoration: none;
        padding: 13px 28px;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-back:hover {
        background-color: #004332;
        transform: translateY(-2px);
    }

   @media (max-width: 768px) {
    .error-image img {
        max-width: 280px;
    }
}

        .error-image img {
            max-width: 280px;
        }

        .error-content h1 {
            font-size: 100px;
        }

        .error-message {
            font-size: 26px;
        }
    
</style>
