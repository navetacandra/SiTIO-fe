---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
---

<Page title="/user/inbound">
    <Sidebar active="inbound" isUser="1"/>
    <Navbar />
    <main id="/user/dashboard">
        <div class="container">
            <div class="empty-state">
                <img src="/inbound.png" alt="No Inbounds Found" width="250" />
                <h2>No Inbounds Found</h2>
                <p>
                    It looks like there are no inbounds available right now. 
                    Click below to create a new inbound
                </p>
                <a href="/user/inbound/create" class="btn-outline-green">Create Inbound</a>
            </div>
        </div>
    </main>
</Page>
