---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
import ProgressStepper from "../../../components/ProgressStepper.astro";
---

<Page title="Details Inbound">
    <Sidebar active="inbound/details" isUser="1" />
    <Navbar />
    <main id="/user/inbound/details">
        <div class="container">
            <div class="title-container">
                <h2 class="title">Details Inbound</h2>
                <p class="subtitle">Programs available for inbound applications</p>
            </div>

            <div class="card3">
                <div class="title-container">
                    <h3 class="title details-title">
                        <span>Inbound #540000</span>
                    </h3>
                </div>

                <div class="card-detail">
                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">CREATOR</p>
                            <p class="content-title">LETTER OF ACCEPTANCE</p>
                            <p class="content-title">IDENTITY CARD</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Risky Pratama</p>
                            <p class="content-body" style="font-weight: 500;">
                                <a href="/Acceptance-Letter.pdf" target="_blank" rel="noopener noreferrer" class="content-file">
                                    <img src="/docs.svg" alt="Document Icon" width="16" height="16" />
                                    <span>Acceptance-Letter.pdf</span>
                                </a>
                            </p>
                            <p class="content-body" style="font-weight: 500;">
                                <a href="/Identity-Card.pdf" target="_blank" rel="noopener noreferrer" class="content-file">
                                    <img src="/docs.svg" alt="Document Icon" width="16" height="16" />
                                    <span>Identity-Card.pdf</span>
                                </a>
                            </p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">BIRTHDATE</p>
                            <p class="content-title">PASSPORT NUMBER</p>
                            <p class="content-title">PASSPORT EXPIRY</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">14 Mar 2026</p>
                            <p class="content-body" style="font-weight: 500;">766863568262</p>
                            <p class="content-body" style="font-weight: 500;">14 Mar 2026</p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">BIRTH LOCATION</p>
                            <p class="content-title">GO AS</p>
                            <p class="content-title">SUBMISSION DATE</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Belanda</p>
                            <p class="content-body" style="font-weight: 500;">Mahasiswa</p>
                            <p class="content-body" style="font-weight: 500;">24 Sept 2026</p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">DECIDERCOUNTRY OF ORIGIN</p>
                            <p class="content-title">ADDRESS</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Belanda</p>
                            <p class="content-body" style="font-weight: 500;">Depok</p>
                        </div>
                    </div>
                </div>

                <br/>
                <div class="card-detail">
                    <div style="padding-bottom: 1.5%;">
                        <div class="input-cols">
                            <p class="content-title">LETTER TYPE</p>
                            <p class="content-title">INBOUND PROGRAM</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Warranty</p>
                            <p class="content-body" style="font-weight: 500;">Study</p>
                        </div>
                    </div>

                    <div style="padding: bottom 1.5%;">
                        <div class="input-cols">
                            <p class="content-title">DURATION</p>
                            <p class="content-title">DURATION UNIT</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">---</p>
                            <p class="content-body" style="font-weight: 500;">Not Set</p>
                        </div>
                    </div>
                </div>
                <ProgressStepper 
                        steps={[
                            { title: "Baru Diajukan", date: "24 Sept 2026", status: "completed" },
                            { title: "Verifikasi Dokumen", date: "24 Sept 2026", status: "completed" },
                            { title: "Ditolak", date: "25 Sept 2026", status: "error" },
                            { title: "Selesai", date: "30 Sept 2026", status: "pending" }
                        ]}
                        note={{
                            title: "Alasan Penolakan:",
                            message: "Masa berlaku paspor dinas kurang dari 6 bulan dari jadwal kegiatan.",
                            type: "error"
                        }}
                />
            </div>
        </div>
        <a href="/user/inbound" class="back" style="padding-left: 3%;">Back to Inbound</a>
    </main>
</Page>
<style>
  tr td {
    padding: 10px;
  }
</style>
