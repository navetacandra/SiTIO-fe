---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
---

<Page title="Paspor Dinas">
    <Sidebar active="pasporDinas" isUser="1"/>
    <Navbar />
    <main id="/user/dashboard">
        <div class="container">
            <div class="empty-state">
                <img src="/paspordinas.png" alt="No Paspor Dinas Found" width="250" />
                <h2>No Paspor Dinas Found</h2>
                <p>
                    It looks like there are no Paspor Dinas available right now. 
                    Click below to create a new Paspor Dinas
                </p>
                <a href="/user/pasporDinas/create" class="btn-outline-green">Create Paspor Dinas</a>
            </div>
        </div>
    </main>    
</Page>
            