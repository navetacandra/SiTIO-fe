---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
---

<Page title="Home">
  <Sidebar active="pasporDinas/details" isUser="1"/>
  <Navbar />
  <main>
    <div class="container">
      <div class="card3" style="margin-bottom: 2%;">
        <div class="title-container">
          <h3 class="title details-title">
            <span>#600000 · Summer Course Sustainable Development# </span>
          </h3>
        </div>

        <div class="card-detail">
          <div style="padding-bottom: 1.5%">
            <div class="input-cols">
              <p class="content-title">CREATOR</p>
              <p class="content-title">SUBMISSION TYPE</p>
            </div>
            <div class="input-cols">
              <p class="content-body" style="font-weight: 500;">Somchai Prasert</p>
              <p class="content-body" style="font-weight: 500;">Exit Permit</p>
            </div>
          </div>

          <div style="padding-bottom: 1.5%">
            <div class="input-cols">
              <p class="content-title">KERPREG</p>
              <p class="content-title">AKTA KELAHIRAN</p>
            </div>
            <div class="input-cols">
              <p class="content-file">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                </svg>
                Kerpreg.pdf
              </p>
              <p class="content-file">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                </svg>
                Akta-Lahir.pdf
              </p>
            </div>
          </div>

          <div style="padding-bottom: 1.5%">
            <div class="input-cols">
              <p class="content-title">IJAZAH TERAKHIR</p>
              <p class="content-title">KARTU KELUARGA</p>
            </div>
            <div class="input-cols">
              <p class="content-file">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                </svg>
                Ijazah.pdf
              </p>
             <p class="content-file">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                </svg>
                KK.pdf
              </p>
            </div>
          </div>

          <div style="padding-bottom: 1.5%">
            <div class="input-cols">
              <p class="content-title">FOTO</p>
              <p class="content-title">SK PNS</p>
            </div>
            <div class="input-cols">
              <p class="content-file">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                </svg>
                Foto.pdf
              </p>
              <p class="content-file">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                </svg>
                SK-PNS.pdf
              </p>
            </div>
          </div>
        </div>

        <div class="input-cols2" style="margin-top: 30px;">
          <div class="card">
            <div class="title-container">
              <h3 class="title">Update Status</h3>
            </div>
            <p class="label">New Status</p>
            <div class="status-row">
              <div class="dropdown">
                <button class="dropbtn">
                  Approved (current)
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
                <div class="dropdown-content">
                  <a href="#">Rejected</a>
                  <a href="#">Pending</a>
                  <a href="#">Approved</a>
                </div>
              </div>
              <input type="submit" class="btn-submit2" value="Apply" />
            </div>
          </div>

          <div class="card">
            <div class="title-container">
              <h3 class="title">Upload Passport</h3>
            </div>
            <p class="label">Choose File</p>
            <div class="status-row">
              <div class="dropdown">
                <div class="dropbtn">
                  <span>Upload</span>
                  <input id="Undangan" type="file" required />
                </div>
              </div>
              <input type="submit" class="btn-submit2" value="Apply" />
            </div>
          </div>
        </div>
      </div>

      <a href="/user/pasporDinas" class="back" >
        Back to Paspor Dinas
      </a>
    </div>
  </main>
</Page>