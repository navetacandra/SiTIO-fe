---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
---

<Page title="/user/outbound">
    <Sidebar active="outbound" isUser="1"/>
    <Navbar />
    <main id="/user/dashboard">
        <div class="container">
            <div class="empty-state">
                <img src="/outbound.png" alt="No Outbounds Found" width="250" />
                <h2>No Outbounds Found</h2>
                <p>
                    It looks like there are no outbounds available right now. 
                    Click below to create a new outbound
                </p>
                <a href="/user/outbound/create" class="btn-outline-green">Create Outbound</a>
            </div>
        </div>
    </main>
</Page>
