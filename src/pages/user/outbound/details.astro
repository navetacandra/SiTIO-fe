---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
import ProgressStepper from "../../../components/ProgressStepper.astro";
---

<Page title="Details Outbound">
    <Sidebar active="outbound/details" isUser="1" />
    <Navbar />
    <main id="/user/outbound/details">
        <div class="container">
            <div class="title-container">
                <h2 class="title">Details Outbound</h2>
                <p class="subtitle">Programs available for outbound applications</p>
            </div>

            <div class="card3">
                <div class="title-container">
                    <h3 class="title details-title">
                        <span>Outbound #300000</span>
                    </h3>
                </div>

                <div class="card-detail">
                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">CREATOR</p>
                            <p class="content-title">START DATE</p>
                            <p class="content-title">GO AS</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Risky Pratama</p>
                            <p class="content-body" style="font-weight: 500;">02 Mar 2026</p>
                            <p class="content-body" style="font-weight: 500;">Mahasiswa</p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">ACADEMIC YEAR / SEMESTER</p>
                            <p class="content-title">END DATE</p>
                            <p class="content-title">SUBMISSION DATE</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">2025 / 2</p>
                            <p class="content-body" style="font-weight: 500;">14 Mar 2026</p>
                            <p class="content-body" style="font-weight: 500;">24 September 2026</p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">PROGRAM</p>
                            <p class="content-title">DECIDED AT</p>
                            <p class="content-title">LETTER TYPE</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Research Collaboration</p>
                            <p class="content-body" style="font-weight: 500;">-</p>
                            <p class="content-body" style="font-weight: 500;">Enrollment</p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">DESTINATION COUNTRY</p>
                            <p class="content-title">DECIDER</p>
                            <p class="content-title">LETTER OF ACCEPTANCE</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">China</p>
                            <p class="content-body" style="font-weight: 500;">-</p>
                            <p class="content-body" style="font-weight: 500;">Not uploaded</p>
                        </div>
                    </div>
                </div>

                <ProgressStepper
                    steps={[
                        { title: "Baru Diajukan", date: "24 Sept 2026", status: "completed" },
                        { title: "Verifikasi Dokumen", date: "24 Sept 2026", status: "completed" },
                        { title: "Disetujui", date: "25 Sept 2026", status: "completed" },
                        { title: "Selesai", date: "30 Sept 2026", status: "completed" }
                    ]}
                    note={{
                        title: "Catatan Admin",
                        message: "Lorem ipsum dolor set amor cisco el manor el adamor nor avatardos un werden fartheus misentrus color mi espos no mi estas do colo makise kurisu makima goku el tissa",
                        type: "default"
                    }}
                />
            </div>
        </div>
        <a href="/user/outbound" class="back" style="padding-left: 3%;">Go back</a>
    </main>
</Page>
<style>
  tr td {
    padding: 10px;
  }
</style>