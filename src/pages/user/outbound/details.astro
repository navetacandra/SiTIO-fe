---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
import ProgressStepper from "../../../components/ProgressStepper.astro";
---

<Page title="Details Outbound">
    <Sidebar active="outbound/details" isUser="1" />
    <Navbar />
    <main id="/user/outbound/details">
        <div class="container">
            <div class="title-container" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <div style="display: flex; align-items: center; gap: 8px; font-size: 20px; font-weight: 700;">
                    <a href="/user/outbound" style="color: #065641; text-decoration: none;">Outbound</a>
                    <span style="color: #6b7280; font-weight: 400; font-size: 15px;">&gt;</span>
                    <span style="color: #065641;">Detail</span>
                </div>
                <div style="display: inline-flex; align-items: center; gap: 7px; background: #fff; border: 1px solid #d1d5db; border-radius: 9999px; padding: 3px 10px 3px 4px; font-size: 11px; font-weight: 600; color: #065641;">
                    <span style="width: 22px; height: 22px; border-radius: 9999px; background: #065641; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">U</span>
                    <span>USER</span>
                    <span style="color: #4b5563; font-size: 10px;">&#8964;</span>
                </div>
            </div>

            <div class="title-container">
                <h2 class="title">Details Outbound</h2>
                <p class="subtitle">Programs available for outbound applications</p>
            </div>

            <div class="card3">
                <div class="title-container" style="display: flex; align-items: center; justify-content: space-between;">
                    <h3 class="title details-title" style="display: flex; align-items: center; gap: 8px;">
                        <span>Outbound #300000</span>
                        <span style="display: inline-flex; align-items: center; gap: 4px; background: #e9f542; color: #3f4600; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 5px;">
                            <span style="font-size: 10px;">&bull;</span>
                            <span>Pending</span>
                        </span>
                    </h3>
                    <a href="/user/outbound/edit" style="background: #f59e0b; color: #fff; padding: 6px 12px; border-radius: 6px; text-decoration: none; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                        </svg>
                        <span>Edit Outbound</span>
                    </a>
                </div>

                <div class="card-detail">
                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">CREATOR</p>
                            <p class="content-title">START DATE</p>
                            <p class="content-title">GO AS</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Risky Pratama</p>
                            <p class="content-body" style="font-weight: 500;">02 Mar 2026</p>
                            <p class="content-body" style="font-weight: 500;">Mahasiswa</p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">ACADEMIC YEAR / SEMESTER</p>
                            <p class="content-title">END DATE</p>
                            <p class="content-title">SUBMISSION DATE</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">2025 / 2</p>
                            <p class="content-body" style="font-weight: 500;">14 Mar 2026</p>
                            <p class="content-body" style="font-weight: 500;">24 September 2026</p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">PROGRAM</p>
                            <p class="content-title">DECIDED AT</p>
                            <p class="content-title">LETTER TYPE</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Research Collaboration</p>
                            <p class="content-body" style="font-weight: 500;">-</p>
                            <p class="content-body" style="font-weight: 500;">Enrollment</p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">DESTINATION COUNTRY</p>
                            <p class="content-title">DECIDER</p>
                            <p class="content-title">LETTER OF ACCEPTANCE</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">China</p>
                            <p class="content-body" style="font-weight: 500;">-</p>
                            <p class="content-body" style="font-weight: 500;">Not uploaded</p>
                        </div>
                    </div>
                </div>

                <ProgressStepper
                    steps={[
                        { title: "Baru Diajukan", date: "24 Sept 2026", status: "completed" },
                        { title: "Verifikasi Dokumen", date: "24 Sept 2026", status: "completed" },
                        { title: "Disetujui", date: "25 Sept 2026", status: "completed" },
                        { title: "Selesai", date: "30 Sept 2026", status: "completed" }
                    ]}
                    note={{
                        title: "Catatan Admin",
                        message: "Lorem ipsum dolor set amor cisco el manor el adamor nor avatardos un werden fartheus misentrus color mi espos no mi estas do colo makise kurisu makima goku el tissa",
                        type: "default"
                    }}
                />
            </div>
        </div>
        <a href="/user/outbound" class="back" style="padding-left: 3%;">Go back</a>
    </main>
</Page>
<style>
  tr td {
    padding: 10px;
  }
</style>