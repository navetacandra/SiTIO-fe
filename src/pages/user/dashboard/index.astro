---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
import ProgressStepper from "../../../components/ProgressStepper.astro";
---

<Page title="Dashboard">
    <Sidebar active="dashboard" isUser="1" />
    <Navbar />
    <main id="dashboard">
        <div class="container">
            <div class="title-container">
                    <h2 class="title" style="font-size: 1.4rem;">International Activities Overview</h2>
                </div>
            <div class="dashboard-left">
            <div class="card-dashboard-list">
                <div class="card-dashboard">
                    <img class="card-watermark" src="/docs.svg" alt="" width="60" />
                    <div style="margin-left: 10%;">
                    <h3 class="card-title"><img src="/docs.svg" alt="No Paspor Dinas Found" width="12" style="transform: translateY(2px);" /><span style="margin-left: 5%;">Total PDLN</span></h3>
                    <p class="card-content" style="margin-left: 9%;">20</p>
                    <p class="card-footer" style="margin-left: 9%;">Activities</p>
                    </div>
                </div>
                <div class="card-dashboard" style="transform: translateY(11px);">
                    <img class="card-watermark" src="/pesawat-turun.svg" alt="" width="150" style="transform: translateX(49px) translateY(-12px);"/>
                    <div style="margin-left: 4%; transform: translateY(-11px);">
                    <h3 class="card-title"><img src="/pesawat-turun.svg" alt="Total Inbound" width="40" style="transform: translateY(7px);" /><span style="margin-left: 0%;">Total Inbound</span></h3>
                    <p class="card-content" style="margin-left: 15%;">21</p>
                    <p class="card-footer" style="margin-left: 15%;">Requests</p>
                    </div>
                </div>
                <div class="card-dashboard" style="transform: translateY(21px);">
                    <img class="card-watermark" src="/pesawat-naik.svg" alt="" width="150" style="transform: translateX(49px) translateY(-15px);"/>
                    <div style="margin-left: 4%; transform: translateY(-21px);">
                    <h3 class="card-title"><img src="/pesawat-naik.svg" alt="Total Inbound" width="48" style="transform: translateY(13px);" /><span style="margin-left: -3%;">Total Outbound</span></h3>
                    <p class="card-content" style="margin-left: 15%;">5</p>
                    <p class="card-footer" style="margin-left: 15%;">Requests</p>
                    </div>
                </div>

                <div class="chart-containers">
                <div class="chart-container card">
                    <h3 class="card-title">Activity Trend This Year</h3>
                    <div id="activity-trend-legend" class="chart-legend"></div>
                    <canvas id="activity-trend"></canvas>
                </div>
                
                </div>
                
            </div>

            <div class="dashboard-right ">
                <div class="chart-container card">
                    <h3 class="card-title">Top Visited Countries</h3>
                    <div class="top-destination-chart">
                        <canvas id="top-destination"></canvas>
                    </div>
                </div>
            </div>
            </div>

             <div class="applications-header">
                <h2 style="font-size: 1.4rem; color: var(--green); margin: 0;">My Applications</h2>
                <div class="slider-controls">
                    <button type="button" class="slider-btn" id="slide-prev" aria-label="Previous Application">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                    <span class="slider-counter" id="slide-counter">1 / 3</span>
                    <button type="button" class="slider-btn" id="slide-next" aria-label="Next Application">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
             </div>
               
             <div class="applications-carousel-wrapper">
                <div class="applications-carousel" id="applications-carousel">

                    <!-- SLIDE 1: Approved -->
                    <div class="carousel-item">
                        <div class="card3" style="padding: 2.5%; width: 100%; box-sizing: border-box;">
                            <div class="title-container">
                                <h3 class="title details-title">
                                    <span>Outbound Submission - Penelitian Kolaboratif Keamanan Siber</span>
                                    <a href="/user/outbound/create" class="btn-outline-green">Document Details</a>
                                </h3>
                                <p class="subtitle2">ID : #20000</p>
                            </div>
                            <div class="card-detail">
                                <div style="padding-bottom: 1.5%">
                                    <div class="input-cols">
                                        <p class="content-title">CREATOR</p>
                                        <p class="content-title">Go As</p>
                                    </div>
                                    <div class="input-cols">
                                        <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">Riski Pratama</p>
                                        <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">Student</p>
                                    </div>
                                </div>
                                <div style="padding-bottom: 1.5%">
                                    <div class="input-cols">
                                        <p class="content-title">DESTINATION</p>
                                        <p class="content-title">SUBMISSION DATE</p>
                                    </div>
                                    <div>
                                        <div class="input-cols">
                                            <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">China</p>
                                            <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">24 September 2026</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <ProgressStepper 
                                steps={[
                                    { title: "Baru Diajukan", date: "24 Sept 2026", status: "completed" },
                                    { title: "Verifikasi Dokumen", date: "24 Sept 2026", status: "completed" },
                                    { title: "Disetujui", date: "25 Sept 2026", status: "completed" },
                                    { title: "Selesai", date: "26 Sept 2026", status: "completed" }
                                ]}
                                note={{
                                    title: "Catatan Admin:",
                                    message: "Pengajuan Anda telah disetujui. Silakan cetak dokumen resmi untuk keperluan keberangkatan."
                                }}
                            />
                        </div>
                    </div>

                    <!-- SLIDE 2: Ditolak -->
                    <div class="carousel-item">
                        <div class="card3" style="padding: 2.5%; width: 100%; box-sizing: border-box;">
                            <div class="title-container">
                                <h3 class="title details-title">
                                    <span>PDLN Submission - Konferensi Internasional AI & Robotika</span>
                                    <a href="/user/pdln/create" class="btn-outline-green">Document Details</a>
                                </h3>
                                <p class="subtitle2">ID : #20001</p>
                            </div>
                            <div class="card-detail">
                                <div style="padding-bottom: 1.5%">
                                    <div class="input-cols">
                                        <p class="content-title">CREATOR</p>
                                        <p class="content-title">Go As</p>
                                    </div>
                                    <div class="input-cols">
                                        <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">Riski Pratama</p>
                                        <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">Student</p>
                                    </div>
                                </div>
                                <div style="padding-bottom: 1.5%">
                                    <div class="input-cols">
                                        <p class="content-title">DESTINATION</p>
                                        <p class="content-title">SUBMISSION DATE</p>
                                    </div>
                                    <div>
                                        <div class="input-cols">
                                            <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">Jepang</p>
                                            <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">10 Oktober 2026</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <ProgressStepper 
                                steps={[
                                    { title: "Baru Diajukan", date: "10 Okt 2026", status: "completed" },
                                    { title: "Verifikasi Dokumen", date: "12 Okt 2026", status: "completed" },
                                    { title: "Ditolak", date: "14 Okt 2026", status: "error" },
                                    { title: "Selesai", date: "-", status: "pending" }
                                ]}
                                note={{
                                    title: "Alasan Penolakan:",
                                    message: "Masa berlaku paspor dinas kurang dari 6 bulan dari jadwal kegiatan.",
                                    type: "error"
                                }}
                            />
                        </div>
                    </div>

                    <!-- SLIDE 3: Revisi -->
                    <div class="carousel-item">
                        <div class="card3" style="padding: 2.5%; width: 100%; box-sizing: border-box;">
                            <div class="title-container">
                                <h3 class="title details-title">
                                    <span>Inbound Submission - Pertukaran Mahasiswa Tokyo Tech</span>
                                    <a href="/user/inbound/create" class="btn-outline-green">Document Details</a>
                                </h3>
                                <p class="subtitle2">ID : #20002</p>
                            </div>
                            <div class="card-detail">
                                <div style="padding-bottom: 1.5%">
                                    <div class="input-cols">
                                        <p class="content-title">CREATOR</p>
                                        <p class="content-title">Go As</p>
                                    </div>
                                    <div class="input-cols">
                                        <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">Riski Pratama</p>
                                        <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">Student</p>
                                    </div>
                                </div>
                                <div style="padding-bottom: 1.5%">
                                    <div class="input-cols">
                                        <p class="content-title">DESTINATION</p>
                                        <p class="content-title">SUBMISSION DATE</p>
                                    </div>
                                    <div>
                                        <div class="input-cols">
                                            <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">Singapura</p>
                                            <p class="content-body" style="font-weight: 500; padding-top: 1.1%;">02 November 2026</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <ProgressStepper 
                                steps={[
                                    { title: "Baru Diajukan", date: "02 Nov 2026", status: "completed" },
                                    { title: "Verifikasi Dokumen", date: "04 Nov 2026", status: "completed" },
                                    { title: "Revisi", date: "05 Nov 2026", status: "warning" },
                                    { title: "Selesai", date: "-", status: "pending" }
                                ]}
                                note={{
                                    title: "Catatan Revisi:",
                                    message: "Mohon upload ulang scan LoA (Letter of Acceptance) resmi yang berstempel.",
                                    type: "warning"
                                }}
                            />
                        </div>
                    </div>

                </div>
             </div>

             <!-- Pagination Dots -->
             <div class="slider-dots" id="slider-dots">
                <button type="button" class="dot active" data-index="0" aria-label="Go to slide 1"></button>
                <button type="button" class="dot" data-index="1" aria-label="Go to slide 2"></button>
                <button type="button" class="dot" data-index="2" aria-label="Go to slide 3"></button>
             </div>
        </div>
    </main>

    <script
        src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.6.1/chart.umd.min.js"
        integrity="sha512-vMRyUfXe50uUhhDC+fk6UYBA/1VPj+I7Jn+wK0A3+wSVeUgT9OCz/xoF2M8KFvrmUOlb4Anv0FQUw8NafuzYPw=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    ></script>
    <script>
        const lineChartCanvas = document.querySelector("#activity-trend");
        const barChartCanvs = document.querySelector("#top-destination");
        const lineChartCtx = lineChartCanvas.getContext("2d");
        const barChartCtx = barChartCanvs.getContext("2d");
        const trendLabels = [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec",
        ];

        // ActivityTrend
        const activityTrendChart = new Chart(lineChartCtx, {
            type: "line",
            data: {
                labels: trendLabels,
                datasets: [
                    {
                        label: "PDLN",
                        data: [30, 69, 57, 14, 62, 68, 80, 65, 38, 21, 85, 99],
                        fill: false,
                        borderColor: "#973A93DD",
                        tension: 0.3,
                        pointRadius: 5,
                
                    },
                    {
                        label: "Outbound",
                        data: [42, 66, 15, 74, 27, 2, 61, 73, 83, 75, 81, 0],
                        fill: false,
                        borderColor: "#1BC0C4DD",
                        tension: 0.3,
                        pointRadius: 5,
                    },
                    {
                        label: "Inbound",
                        data: [22, 3, 44, 6, 32, 96, 51, 89, 85, 56, 60, 90],
                        fill: false,
                        borderColor: "#E68FC2DD",
                        tension: 0.3,
                        pointRadius: 5,
                    },
                ],
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false,
                    },
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 20,
                        },
                        grid: {
                            color: "#dfe6ea",
                        },
                    },
                    x: {
                        grid: {
                            display: false,
                        },
                    },
                },
            },
        });

        const activityTrendLegend = document.querySelector("#activity-trend-legend");
        activityTrendChart.data.datasets.forEach((dataset, index) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "chart-legend-item";
            button.setAttribute("aria-pressed", "true");

            const dot = document.createElement("span");
            dot.className = "chart-legend-dot";
            dot.style.backgroundColor = dataset.borderColor;

            const label = document.createElement("span");
            label.textContent = dataset.label;

            button.append(dot, label);
            button.addEventListener("click", () => {
                const visible = activityTrendChart.isDatasetVisible(index);
                activityTrendChart.setDatasetVisibility(index, !visible);
                activityTrendChart.update();
                button.setAttribute("aria-pressed", String(!visible));
                button.classList.toggle("is-hidden", visible);
            });
            activityTrendLegend.append(button);
        });

        // TopDestination
        new Chart(barChartCtx, {
            type: "bar",
            data: {
                labels: ["Singapura", "Jepang", "Kanada", "Korea", "China"],
                datasets: [
                    {
                        data: [70, 61, 54, 53, 30],
                        barThickness: 50,
                        categoryPercentage: 0.8,
                        barPercentage: 0.7,
                        backgroundColor: ["#3468FF", "#FFCC00", "#FF383C", "#00C8B3", "#00C0E8"],
                        borderWidth: 0,
                        borderRadius: 3,
                        borderSkipped: false,
                    },
                ],
            },
            options: {
                indexAxis: "y",
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false,
                    },
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 20,
                        },
                    },
                    y: {
                        grid: {
                            display: false,
                        },
                    },
                },
            },
        });

        // Carousel Application Slider
        const carousel = document.querySelector("#applications-carousel");
        const prevBtn = document.querySelector("#slide-prev");
        const nextBtn = document.querySelector("#slide-next");
        const dots = document.querySelectorAll(".slider-dots .dot");
        const counterEl = document.querySelector("#slide-counter");
        const items = document.querySelectorAll(".carousel-item");
        let activeIndex = 0;
        const totalItems = items.length;

        function updateSlider(index) {
            if (index < 0) index = 0;
            if (index >= totalItems) index = totalItems - 1;
            activeIndex = index;

            // Scroll carousel
            carousel.style.transform = `translateX(-${activeIndex * 100}%)`;

            // Update counter
            if (counterEl) {
                counterEl.textContent = `${activeIndex + 1} / ${totalItems}`;
            }

            // Update dots
            dots.forEach((dot, idx) => {
                dot.classList.toggle("active", idx === activeIndex);
            });

            // Update button states
            if (prevBtn) prevBtn.disabled = activeIndex === 0;
            if (nextBtn) nextBtn.disabled = activeIndex === totalItems - 1;
        }

        if (prevBtn && nextBtn && carousel) {
            prevBtn.addEventListener("click", () => updateSlider(activeIndex - 1));
            nextBtn.addEventListener("click", () => updateSlider(activeIndex + 1));

            dots.forEach((dot) => {
                dot.addEventListener("click", (e) => {
                    const idx = parseInt(e.currentTarget.getAttribute("data-index"), 10);
                    updateSlider(idx);
                });
            });

            // Initialize
            updateSlider(0);
        }
    </script>
</Page>