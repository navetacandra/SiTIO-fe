                            <span>Bagas Setiawan</span>
                            <span class="content-body-thin-role">MAHASISWA - bagas.setiawan@io.pnj.ac.id</span>
                        </div>
                        <div class="content-body" style="display: flex; justify-content: space-between;">
                            <span>Budi Santoso</span>
                            <span class="content-body-thin-role">SUPERADMIN - superadmin@io.pnj.ac.id</span>
                        </div>
                        <div class="content-body" style="display: flex; justify-content: space-between;">
                            <span>Dewi Lestari, M.M</span>
                            <span class="content-body-thin-role">DOSEN - dewi.lestari@io.pnj.ac.id</span>
                        </div>
                        <div class="content-body" style="display: flex; justify-content: space-between;">
                            <span>Dr. Ahmad Fauzi, M.T.</span>
                            <span class="content-body-thin-role">STRUKTURAL - wakil.dekan@io.pnj.ac.id</span>
                        </div>
                        <div class="content-body" style="display: flex; justify-content: space-between;">
                            <span>Dr. Rina Wijaya, M.Kom.</span>
                            <span class="content-body-thin-role">DOSEN - rina.wijaya@io.pnj.ac.id</span>
                        </div>
                    </div>

