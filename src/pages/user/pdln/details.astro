---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
import Input from "../../../components/Input.astro";
import ProgressStepper from "../../../components/ProgressStepper.astro";
---

<Page title="Home">
    <Sidebar active="dashboard" isUser="1" />
    <Navbar />
    <main>
        <div class="container">
            <div class="card3">
               <div class="title-container">
                    <div class="details-title">
                        <div style="display: flex; align-items: center; gap: 14px;">
                            <h3 class="title" style="margin: 0;">PDLN #23000</h3>
                            <span class="badge pending">
                                <span class="dot">●</span> Pending
                            </span>
                        </div>
                        <a href="/user/pdln/edit" class="btn-edit">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                                <path d="m15 5 4 4" />
                            </svg>
                            Edit PDLN
                        </a>
                    </div>
                </div>

                <div class="card-detail">
                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">CREATOR</p>
                            <p class="content-title" style="margin-left: 13%;">DESTINATION INSTITUTION</p>
                            <p class="content-title">IDENTITY CARD</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Risky Pratama <span class="content-body-thin">MAHASISWA</span></p>
                            <p class="content-body" style="font-weight: 500; margin-left: 13%;">02 Mar 2026</p>
                            <p class="content-file">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="15"
                                    height="15"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <path d="M14 2v6h6" />
                                </svg>
                                Kerpreg.pdf
                            </p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">ACTIVITY NAME</p>
                            <p class="content-title" style="margin-left: 13%;">DESTINATION CITY</p>
                            <p class="content-title">PASSPORT EXPIRY</p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Hackafest</p>
                            <p class="content-body" style="font-weight: 500; margin-left: 13%;">14 Mar 2026</p>
                            <p class="content-body" style="font-weight: 500;">Enrollment</p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">ACTIVITY TYPE</p>
                            <p class="content-title" style="margin-left: 13%;">START DATE</p>
                            <p class="content-title"></p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Research Collaboration</p>
                            <p class="content-body" style="font-weight: 500; margin-left: 13%;">31 Des 2026</p>
                            <p class="content-body" style="font-weight: 500;"></p>
                        </div>
                    </div>

                    <div style="padding-bottom: 1.5%">
                        <div class="input-cols">
                            <p class="content-title">DESTINATION COUNTRY</p>
                            <p class="content-title" style="margin-left: 13%;">SUBMISSION DATE</p>
                            <p class="content-title"></p>
                        </div>
                        <div class="input-cols">
                            <p class="content-body" style="font-weight: 500;">Belanda</p>
                            <p class="content-body" style="font-weight: 500; margin-left: 13%;">24 Sept 2026</p>
                            <p class="content-body" style="font-weight: 400; opacity: 0.4;"></p>
                        </div>
                    </div>
                </div>

                <div class="input-cols2" style="margin-top: 30px;">
