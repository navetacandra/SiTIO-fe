---
import Page from "../../../template/Page.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Navbar from "../../../components/Navbar.astro";
---

<Page title="/user/pdln">
    <Sidebar active="pdln" isUser="1"/>
    <Navbar />
    <main id="user-pdln">
        <div class="container">
            <div class="empty-state">
                <img src="/user.png" alt="No PDLN Found" width="250" />
                <h2>No PDLN Found</h2>
                <p>
                    It looks like there are no pdln available right now.<br />
                    Click below to create a new pdln
                </p>
                <a href="/user/pdln/create" class="btn-outline-green">Create PDLN</a>
            </div>
        </div>
    </main>
</Page>