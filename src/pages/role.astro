---
import Page from "../template/Page.astro";
---

<Page title="Role">
    <div class="role-wrapper">
        <div class="role-brand">
            <img src="/logo.png" alt="Logo PNJ" />
            <div class="brand-info">
                <span class="brand-title">SiTIO PNJ</span>
                <span class="brand-subtitle">Sistem Terpusat International Office</span>
            </div>
        </div>

        <div class="role-container">
            <h1 class="role-heading">Who Are You?</h1>

            <div class="role-grid">
                <a href="/registrasi/struktural" class="role-card">
                    <div class="role-icon">
                        <img src="/Struktural.svg" alt="Structural" class="icon-structural"/>
                    </div>
                    <h2 class="role-title">Structural</h2>
                    <p class="role-desc">
                        Staff or officials with managerial and administrative
                        responsibilities in managing the operations of an educational
                        institution, such as rectors, deans, directors, or administrative
                        personnel.
                    </p>
                </a>

                <a href="/registrasi/dosen" class="role-card">
                    <div class="role-icon">
                        <img src="/Dosen.svg" alt="Lecturer" class="icon-lecturer"/>
                    </div>
                    <h2 class="role-title">Lecturer</h2>
                    <p class="role-desc">
                        Professional educators at the higher education level whose duties
                        are to share knowledge by teaching, providing academic guidance to
                        students, and conducting research.
                    </p>
                </a>

                <a href="/registrasi/mahasiswa" class="role-card">
                    <div class="role-icon">
                        <img src="/Mahasiswa.svg" alt="Mahasiswa" class="icon-student"/>
                    </div>
                    <h2 class="role-title">Student</h2>
                    <p class="role-desc">
                        A person enrolled as a learner at a college or university who is
                        pursuing higher education studies to earn an academic degree.
                    </p>
                </a>
            </div>
        </div>
    </div>
</Page>