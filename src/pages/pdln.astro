                        <h3 class="card-title">Pending</h3>
                        <p class="card-content">1</p>
                    </div>
                    <div class="card">
                        <h3 class="card-title">Verification</h3>
                        <p class="card-content">1</p>
                    </div> 
                    <div class="card">
                        <h3 class="card-title">Revision</h3>
                        <p class="card-content">1</p>
                    </div>
                    <div class="card">
                        <h3 class="card-title">Srikandi</h3>
