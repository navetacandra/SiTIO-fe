---
import Page from "../template/Page.astro";
import Sidebar from "../components/Sidebar.astro";
import Navbar from "../components/Navbar.astro";
import Input from "../components/Input.astro";
---


<Page title="Home">
    <Sidebar active="dashboard" />
    <Navbar />
    <main>
        <div class="container">
            
            <div class="card3">
                <div class="title-container">
                    <h3 class="title details-title">
                        <span>#600000 · Summer Course Sustainable Development# </span>
                    </h3>

                </div>
                <div class="card-detail">
                <div style="padding-bottom: 1.5%">
                <div class="input-cols">
               <p class="content-title">CREATOR</p>
               <p class="content-title">PASSPORT</p>
                </div>
                <div class="input-cols">
               <p class="content-body" style="font-weight: 500;">Somchai Prasert</p>
               <p class="content-body" style="font-weight: 500;">B1000003 (expires 30 Sep 2029)</p>
                </div>
                </div>
                
                <div style="padding-bottom: 1.5%">
                <div class="input-cols">
               <p class="content-title">BIRTHDATE</p>
               <p class="content-title">DURATIONED</p>
                </div>
                <div class="input-cols">
               <p class="content-body" style="font-weight: 500;">02 Nov 2000 · Bangkok</p>
               <p class="content-body" style="font-weight: 500;">1 MONTH</p>
                </div>
                </div>

                <div style="padding-bottom: 1.5%">
                <div class="input-cols">
               <p class="content-title">ADDRESS</p>
               <p class="content-title">LETTER</p>
                </div>
                <div class="input-cols">
               <p class="content-body" style="font-weight: 500;">No. 42 Sukhumvit Road, Bangkok, Thailand</p>
               <p class="content-body" style="font-weight: 500;">Open Letter</p>
                </div>
                </div>

                <div style="padding-bottom: 1.5%">
                <div class="input-cols">
               <p class="content-title">DECIDER</p>
               <p class="content-title">LETTER TYPE</p>
                </div>
                <div class="input-cols">
               <p class="content-body" style="font-weight: 500;">Dr. Ahmad Fauzi, M.T.</p>
               <p class="content-body" style="font-weight: 500;">Warranty</p>
                </div>
                </div>
                
            </div>
            <div class="input-cols2" style="margin-top: 30px;">
                <div class="card"> 
                        <div class="title-container">
                    <h3 class="title">Update Status</h3>
                </div>
                        <p class="label">New Status</p>
                    <div class="status-row">
                        <div class="dropdown">
                <button class="dropbtn">Approved (current) 
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                    </svg>
                </button>
                <div class="dropdown-content">
                <a href="#">Rejected</a>
                <a href="#">Link 2</a>
                <a href="#">Link 3</a>
                </div>
                </div>
                 <input type="submit" class="btn-submit2" value="Apply">
             
             </div>

                    </div>
                <div class="card"> 
                          <div class="title-container">
                    <h3 class="title">Upload Letter</h3>
                </div>
                        <p class="label">Choose File</p>
                    <div class="status-row">
                        <div class="dropdown">
                            <div class="dropbtn">
                                <span>Upload</span>
                                <input
                                    id="Undangan"
                                    type="file"
                                    required
                                />
                    </div>
                </div>
                 <input type="submit" class="btn-submit2" value="Apply">
             
             </div>
                </div>

                </div>
            </div>
            </div>

            <a href="inbound" class="back" style="padding-left: 3%;">Back to Inbound</a>

    </main>
</Page>
<style>
    tr td {
        padding: 10px;
    }
</style>