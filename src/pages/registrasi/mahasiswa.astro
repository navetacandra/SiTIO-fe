---
import Page from "../../template/Page.astro";
import Input from "../../components/Input.astro";
---

<Page title="Registrasi Mahasiswa">
    <div class="registrasi-wrapper">
        <div class="registrasi-brand">
            <img src="/logo.png" alt="Logo PNJ" />
            <div class="brand-info">
                <span class="brand-title">STIO PNJ</span>
                <span class="brand-subtitle">Sistem Terpusat International Office</span>
            </div>
        </div>

        <div class="registrasi-card">
            <h1 class="register-title">Register Mahasiswa</h1>
            <form id="registrasiForm" method="POST">
                <div class="title-container">
                    <h3 class="title">Personal Details</h3>
                </div>

                <Input
                    label="Full Name"
                    id="full_name"
                    placeholder="Full name of the applicant"
                    type="text"
                    required
                    showRequired
                />

                <div class="input-cols">
                    <Input
                        label="NIK"
                        id="nik"
                        placeholder="Nomor Induk Keluarga"
                        type="number"
                        required
                        showRequired
                    />
                    <Input
                        label="Phone"
                        id="phone"
                        placeholder="Ex.085232******"
                        type="number"
                        required
                        showRequired
                    />
                    <Input
                        label="Email"
                        id="email"
                        placeholder="jhon@example.com"
                        type="email"
                        required
                        showRequired
                    />
                    <Input
                        label="Password"
                        id="password"
                        placeholder="Enter your password"
                        type="password"
                        required
                        showRequired
                    />
                    <Input
                        label="Birthplace"
                        id="birth-place"
                        placeholder="Enter your birthplace"
                        type="text"
                        required
                        showRequired
                    />
                    <Input
                        label="Birthdate"
                        id="birth-date"
                        placeholder=""
                        type="date"
                        required
                        showRequired
                    />
                </div>

                <Input
                    label="Address"
                    id="address"
                    placeholder="Enter your address"
                    type="textarea"
                    required
                    showRequired
                />

                <div class="input-cols">
                    <Input
                        label="NIM"
                        id="nim"
                        placeholder="Nomor Induk Mahasiswa"
                        type="number"
                        required
                        showRequired
                    />
                    <Input
                        label="Admission date"
                        id="admission_date"
                        placeholder=""
                        type="date"
                        required
                        showRequired
                    />
                    <Input
                        label="Major"
                        id="major"
                        placeholder="Major of the applicant"
                        type="text"
                        required
                        showRequired
                    />
                    <Input
                        label="Study Program"
                        id="study-program"
                        placeholder="Study Program of the applicant"
                        type="text"
                        required
                        showRequired
                    />
                </div>

                <Input
                    label="Program"
                    id="program"
                    placeholder="Program of the applicant"
                    type="text"
                    required
                    showRequired
                />

                <div class="input-box3">
                    <button type="button" class="btn-registrasi" onclick="document.location='/login'">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</Page>