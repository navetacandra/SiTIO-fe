        <div class="error-container">
            <div class="error-image">
                <img src="/notAllowed.svg" alt="405 NotAllowed"/>
            </div>

            <div class="error-content">
                <h1>405</h1>
                <p class="error-message"> NotAllowed</p>
                <a href="/user/dashboard" class="btn-back">GO BACK</a>
            </div>
        </div>
    </main>
</Page>

