---
import Page from "../../template/Page.astro";
---

<Page title="404 NotFound">
    <main class="error-page">
        <div class="error-container">
            <div class="error-image">
                <img src="/notfound.svg" alt="404 Unauthorized"/>
            </div>

            <div class="error-content">
                <h1>404</h1>
                <p class="error-message">NotFound</p>
                <a href="/user/dashboard" class="btn-back">GO BACK</a>
            </div>
        </div>
    </main>
</Page>

